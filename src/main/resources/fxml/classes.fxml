<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sams.controller.ClassController"
            styleClass="root-pane"
            prefWidth="980" prefHeight="640">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <Label text="SAMS — Class Scheduling" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" styleClass="secondary-button" onAction="#handleBackToDashboard"/>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- Admin Scheduling Form (hidden/disabled for lecturer) -->
            <VBox fx:id="adminFormPane" spacing="10" styleClass="card-pane">
                <Label text="Schedule Class Session" styleClass="heading-label" style="-fx-font-size: 15px;"/>

                <HBox spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Course *" styleClass="form-label"/>
                        <ComboBox fx:id="courseComboBox" promptText="Select Course" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Subject *" styleClass="form-label"/>
                        <ComboBox fx:id="subjectComboBox" promptText="Select Subject" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Assigned Lecturer *" styleClass="form-label"/>
                        <ComboBox fx:id="lecturerComboBox" promptText="Select Lecturer" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Session Date *" styleClass="form-label"/>
                        <DatePicker fx:id="sessionDatePicker" promptText="Choose Date" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Session Time (HH:mm) *" styleClass="form-label"/>
                        <ComboBox fx:id="timeComboBox" promptText="Select or Enter Time" editable="true" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="scheduleBtn" text="Schedule Class" styleClass="primary-button" onAction="#handleScheduleClass"/>
                    <Button fx:id="updateBtn" text="Update Session" styleClass="secondary-button" onAction="#handleUpdateSession"/>
                    <Button fx:id="deleteBtn" text="Delete Session" styleClass="danger-button" onAction="#handleDeleteSession"/>
                    <Button fx:id="clearBtn" text="Clear Form" styleClass="secondary-button" onAction="#handleClearForm"/>
                </HBox>
            </VBox>

            <!-- Class Schedule Table -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card-pane">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="tableHeadingLabel" text="Scheduled Classes" styleClass="heading-label" style="-fx-font-size: 15px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" styleClass="secondary-button" onAction="#handleRefresh"/>
                </HBox>

                <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="45"/>
                        <TableColumn fx:id="dateCol" text="Date" prefWidth="105"/>
                        <TableColumn fx:id="timeCol" text="Time" prefWidth="85"/>
                        <TableColumn fx:id="courseCol" text="Course" prefWidth="230"/>
                        <TableColumn fx:id="subjectCol" text="Subject" prefWidth="240"/>
                        <TableColumn fx:id="lecturerCol" text="Lecturer" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 20 8 20; -fx-background-color: #ecf0f1;">
            <Label fx:id="messageLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>
