<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sams.controller.AttendanceController"
            styleClass="root-pane"
            prefWidth="980" prefHeight="640">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <Label text="SAMS — Attendance Marking" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" styleClass="secondary-button" onAction="#handleBackToDashboard"/>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- Session Selection Card -->
            <VBox spacing="10" styleClass="card-pane">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Select Class Session *" styleClass="form-label"/>
                        <ComboBox fx:id="sessionComboBox" promptText="Select an assigned class session" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Session Details:" styleClass="form-label"/>
                        <Label fx:id="sessionDetailsLabel" text="No class selected" style="-fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <!-- Attendance Statistics -->
                <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                    <Label fx:id="totalCountLabel" text="Total Students: 0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="presentCountLabel" text="Present: 0" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    <Label fx:id="absentCountLabel" text="Absent: 0" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <Label fx:id="lateCountLabel" text="Late: 0" style="-fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Mark All Present" styleClass="secondary-button" onAction="#handleMarkAllPresent"/>
                    <Button text="Mark All Absent" styleClass="secondary-button" onAction="#handleMarkAllAbsent"/>
                    <Button fx:id="saveAttendanceBtn" text="Save Attendance" styleClass="primary-button" onAction="#handleSaveAttendance"/>
                </HBox>
            </VBox>

            <!-- Student Attendance Table -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card-pane">
                <Label text="Enrolled Students (Double-click or click Status to change: PRESENT, ABSENT, LATE)"
                       styleClass="heading-label" style="-fx-font-size: 14px;"/>
                <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS" editable="true">
                    <columns>
                        <TableColumn fx:id="regNoCol" text="Reg Number" prefWidth="140"/>
                        <TableColumn fx:id="nameCol" text="Student Name" prefWidth="250"/>
                        <TableColumn fx:id="statusCol" text="Attendance Status" prefWidth="160"/>
                        <TableColumn fx:id="markedAtCol" text="Last Recorded" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 20 8 20; -fx-background-color: #ecf0f1;">
            <Label fx:id="messageLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>
