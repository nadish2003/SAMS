<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sams.controller.ReportController"
            styleClass="root-pane"
            prefWidth="1020" prefHeight="660">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <Label text="SAMS — Attendance Reports" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" styleClass="secondary-button" onAction="#handleBackToDashboard"/>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- Filters Card -->
            <VBox spacing="10" styleClass="card-pane">
                <Label text="Filter Criteria" styleClass="heading-label" style="-fx-font-size: 15px;"/>

                <HBox spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Filter by Student" styleClass="form-label"/>
                        <ComboBox fx:id="studentComboBox" promptText="All Students" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Filter by Course" styleClass="form-label"/>
                        <ComboBox fx:id="courseComboBox" promptText="All Courses" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Filter by Subject" styleClass="form-label"/>
                        <ComboBox fx:id="subjectComboBox" promptText="All Subjects" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="From Date" styleClass="form-label"/>
                        <DatePicker fx:id="fromDatePicker" promptText="Start Date" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="To Date" styleClass="form-label"/>
                        <DatePicker fx:id="toDatePicker" promptText="End Date" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" alignment="BOTTOM_LEFT">
                        <Label text=" " styleClass="form-label"/>
                        <HBox spacing="8">
                            <Button text="Apply Filters" styleClass="primary-button" onAction="#handleGenerateReport"/>
                            <Button text="Reset Filters" styleClass="secondary-button" onAction="#handleResetFilters"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Statistics Bar -->
                <HBox spacing="25" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
                    <Label fx:id="totalRecordsLabel" text="Total Records: 0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="presentSummaryLabel" text="Present: 0 (0.0%)" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    <Label fx:id="absentSummaryLabel" text="Absent: 0 (0.0%)" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <Label fx:id="lateSummaryLabel" text="Late: 0 (0.0%)" style="-fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                </HBox>
            </VBox>

            <!-- Report Table -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card-pane">
                <Label text="Attendance Records" styleClass="heading-label" style="-fx-font-size: 15px;"/>
                <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="regNoCol" text="Reg Number" prefWidth="120"/>
                        <TableColumn fx:id="nameCol" text="Student Name" prefWidth="160"/>
                        <TableColumn fx:id="courseCol" text="Course" prefWidth="180"/>
                        <TableColumn fx:id="subjectCol" text="Subject" prefWidth="160"/>
                        <TableColumn fx:id="dateCol" text="Date" prefWidth="95"/>
                        <TableColumn fx:id="timeCol" text="Time" prefWidth="75"/>
                        <TableColumn fx:id="lecturerCol" text="Lecturer" prefWidth="140"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="85"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 20 8 20; -fx-background-color: #ecf0f1;">
            <Label fx:id="messageLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>
