<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sams.controller.StudentController"
            styleClass="root-pane"
            prefWidth="950" prefHeight="620">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <Label text="SAMS — Student Management" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" styleClass="secondary-button" onAction="#handleBackToDashboard"/>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- Student Form -->
            <VBox spacing="10" styleClass="card-pane">
                <Label text="Student Details" styleClass="heading-label" style="-fx-font-size: 15px;"/>

                <HBox spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Full Name *" styleClass="form-label"/>
                        <TextField fx:id="nameField" promptText="e.g. Kasun Bandara"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Registration No *" styleClass="form-label"/>
                        <TextField fx:id="regNoField" promptText="e.g. HND-SE-001"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Enrolled Course *" styleClass="form-label"/>
                        <ComboBox fx:id="courseComboBox" promptText="Select Course" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Email Address" styleClass="form-label"/>
                        <TextField fx:id="emailField" promptText="e.g. kasun@mail.com"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Phone Number" styleClass="form-label"/>
                        <TextField fx:id="phoneField" promptText="e.g. 0712345601"/>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="addStudentBtn" text="Add Student" styleClass="primary-button" onAction="#handleAddStudent"/>
                    <Button fx:id="updateStudentBtn" text="Update" styleClass="secondary-button" onAction="#handleUpdateStudent"/>
                    <Button fx:id="deleteStudentBtn" text="Delete" styleClass="danger-button" onAction="#handleDeleteStudent"/>
                    <Button fx:id="clearBtn" text="Clear Form" styleClass="secondary-button" onAction="#handleClearForm"/>
                </HBox>
            </VBox>

            <!-- Students Table -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card-pane">
                <Label text="Enrolled Students Roster" styleClass="heading-label" style="-fx-font-size: 15px;"/>
                <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="regNoCol" text="Reg Number" prefWidth="120"/>
                        <TableColumn fx:id="nameCol" text="Full Name" prefWidth="180"/>
                        <TableColumn fx:id="courseCol" text="Course" prefWidth="200"/>
                        <TableColumn fx:id="emailCol" text="Email" prefWidth="180"/>
                        <TableColumn fx:id="phoneCol" text="Phone" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 20 8 20; -fx-background-color: #ecf0f1;">
            <Label fx:id="messageLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>
